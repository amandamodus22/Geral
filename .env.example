# =====================================================================
# Variáveis de ambiente do Painel de Posts
#
# Na Vercel: Project → Settings → Environment Variables (cole cada uma).
# No computador (opcional): copie este arquivo para ".env.local".
#
# NUNCA coloque chaves secretas em variáveis que começam com NEXT_PUBLIC_
# (essas aparecem no navegador). As secretas abaixo ficam só no servidor.
# =====================================================================

# --- Supabase (Project Settings → API) --------------------------------
# URL do projeto. Ex.: https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave PÚBLICA ("anon" ou "publishable"). Pode aparecer no navegador:
# a segurança vem da RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA ("service_role" ou "secret"). SÓ NO SERVIDOR.
# Usada pelo callback do Make e pelo primeiro login.
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso ------------------------------------------------------------
# O único e-mail que pode entrar no painel.
EMAIL_PERMITIDO=

# --- Segredos compartilhados -------------------------------------------
# Senha longa e aleatória que o Make envia no cabeçalho x-painel-secret
# (nas duas direções: painel → Make e Make → painel).
# Também vai nos "Secrets" da Edge Function.
PAINEL_SECRET=

# Outra senha longa e aleatória, usada pelo pg_cron e pelo painel para
# chamar a Edge Function. Também vai nos "Secrets" da Edge Function e no
# Vault do Supabase (nome: cron_secret).
CRON_SECRET=

# --- IA (botão "Sugerir com IA") ---------------------------------------
# Chave da API da Anthropic (console.anthropic.com → API Keys). SÓ NO SERVIDOR.
ANTHROPIC_API_KEY=
# Opcional: outro modelo. Padrão: claude-opus-5-5
# ANTHROPIC_MODEL=

# --- Upload -------------------------------------------------------------
# Limite (em MB) usado no aviso de upload. Plano gratuito do Supabase: 50.
NEXT_PUBLIC_LIMITE_UPLOAD_MB=50

# =====================================================================
# Estes NÃO vão na Vercel. Vão em Supabase → Edge Functions → Secrets:
#
#   MAKE_WEBHOOK_URL = URL do webhook do cenário no Make
#   PAINEL_SECRET    = o mesmo valor de cima
#   CRON_SECRET      = o mesmo valor de cima
#   PAINEL_URL       = endereço do painel na Vercel, ex.: https://meu-painel.vercel.app
#
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem lá automaticamente.)
# =====================================================================
